{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8000",
  "Backend": {
    "Url": "http://127.0.0.1:8100"
  },
  "ReverseProxy": {
    "Routes": {
      "all": {
        "ClusterId": "python",
        "Match": { "Path": "{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS" ] }
      }
    },
    "Clusters": {
      "python": {
        "HttpRequest": { "ActivityTimeout": "00:20:00" },
        "Destinations": {
          "backend": { "Address": "http://127.0.0.1:8100" }
        }
      }
    }
  }
}
