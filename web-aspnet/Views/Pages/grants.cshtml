@{
    ViewData["Title"] = "Grants · AURAK Research Grants Dashboard";
    var args = M.args; int total = (int)M.total.Num; int page = (int)M.page.Num; int pages = (int)M.pages.Num;
}
@section hero {
<div class="searchband" id="search">
  <form action="/grants" method="get" class="container">
    <i class="fas fa-search"></i>
    <input type="search" name="q" value="@args.q.Or("")" placeholder="Search grants by keyword or topic">
    @foreach (var k in new[] { "scope", "type", "status", "source", "deadline_days", "min_amount", "sort" }) { if (args.Get(k)) {<input type="hidden" name="@k" value="@args[k]">} }
    <input type="hidden" name="mode" value="@args.mode.Or("meaning")">
    <button class="btn" type="submit">Search</button>
  </form>
</div>
}
<div class="container page-head">
  <div class="section-head"><h2>Grants, Fellowships &amp; Scholarships</h2><div class="rule"></div></div>
</div>
<div class="container layout-side">
  <form class="filters" method="get" action="/grants">
    <h3><i class="fas fa-filter"></i> Filters</h3>
    <label for="q">Keywords</label>
    <input id="q" type="text" name="q" value="@args.q.Or("")">
    <label class="check"><input type="checkbox" name="mode" value="meaning" @Chk(args.mode == "meaning")> Match by meaning (AI search)</label>
    <label for="scope">National / International</label>
    <select id="scope" name="scope">
      <option value="">All</option>
      <option value="UAE" @Sel(args.scope == "UAE")>UAE (national)</option>
      <option value="international" @Sel(args.scope == "international")>International</option>
    </select>
    <label for="type">Type</label>
    <select id="type" name="type"><option value="">All types</option>
      @foreach (var t in M.types) {<option value="@t" @Sel(args.type == t)>@Cap(t)</option>}
    </select>
    <label for="area">Research area</label>
    <input id="area" type="text" name="area" value="@args.area.Or("")" placeholder="e.g. energy, health">
    <label for="status">Status</label>
    <select id="status" name="status">
      @foreach (var s in M.statuses) {<option value="@s[0]" @Sel(args.status.Or("active") == s[0])>@s[1]</option>}
    </select>
    <label for="deadline_days">Deadline within</label>
    <select id="deadline_days" name="deadline_days"><option value="">Any time</option>
      @foreach (var d in new[] { 14, 30, 60, 90, 180 }) {<option value="@d" @Sel(args.deadline_days == d.ToString())>@d days</option>}
    </select>
    <label for="min_amount">Minimum amount (in the grant's currency)</label>
    <input id="min_amount" type="number" name="min_amount" min="0" step="1000" value="@args.min_amount.Or("")">
    <label class="check"><input type="checkbox" name="has_amount" value="1" @Chk(args.has_amount)> Amount published only</label>
    <label for="source">Source</label>
    <select id="source" name="source"><option value="">All sources</option>
      @foreach (var s in M.sources) {<option value="@s.key" @Sel(args.source == s.key)>@s.name (@s.records_count)</option>}
    </select>
    <label for="sort">Sort by</label>
    <select id="sort" name="sort">
      @foreach (var (v, l) in new[] { ("deadline", "Closest deadline"), ("newest", "Newest"), ("amount", "Largest amount"), ("relevance", "Relevance (AI search)") }) {<option value="@v" @Sel(args.sort == v)>@l</option>}
    </select>
    <div class="btn-row" style="margin-top:16px"><button class="btn" type="submit">Apply</button><a href="/grants">Reset</a></div>
  </form>
  <div>
    <p class="muted"><b>@total</b> @("result" + (total == 1 ? "" : "s"))@if (args.q) {<text> for “@args.q”</text>}. Closed calls are hidden unless you choose them under Status.</p>
    @if (M.rows)
    {
      foreach (var g in M.rows) {<text> </text>@await Html.PartialAsync("_GrantCard", new Args(g, M.source_names))<text> </text>}
    }
    else {<div class="note">No grants match these filters. Try removing a filter or searching with different words.</div>}
    @if (pages > 1)
    {
    <div class="pager">
      @if (page > 1) {<a href="?@M.qs&page=@(page - 1)">&laquo; Prev</a><text> </text>}
      @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++)
      {
        if (p == page) {<span class="cur">@p</span>} else {<a href="?@M.qs&page=@p">@p</a>}<text> </text>
      }
      @if (page < pages) {<a href="?@M.qs&page=@(page + 1)">Next &raquo;</a>}
    </div>
    }
  </div>
</div>