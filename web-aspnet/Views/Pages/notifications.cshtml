@{ ViewData["Title"] = "Notifications · AURAK Research Grants"; long minScore = (long)Math.Round(Config["NOTIFY_MIN_SCORE"].Num * 100, MidpointRounding.ToEven); }
<div class="container page-head">
  <div class="section-head"><h2>Grant Notifications</h2><div class="rule"></div>
    @if (M.rows) {<form method="post" action="/notifications/read"><button class="btn sm ghost" type="submit">Mark all as read</button></form>}</div>
@if (M.rows) {@await Html.PartialAsync("_ExportBar", new Args("/export/notifications", "", "Export notifications"))}
  <p class="muted">After each refresh (every @Int(M.refresh_hours) hours) the dashboard notifies you about new grants whose scope strongly matches your research (match score @(minScore)+ and among the top @Config["NOTIFY_TOP_N"] matches). In-app only for now; email comes later.</p>
</div>
<div class="container">
  <div class="card">
    @if (M.rows)
    {
      foreach (var n in M.rows)
      {
        var g = M.grants.Get(n.grant_id);
      <div class="notif @(n.read ? "read" : "unread")">
        <span class="dot"></span>
        <div style="flex:1">
          <a href="/notifications/@n.id"><b>@(g ? g.title : n.message)</b></a>
          <div class="small">@if (g) {<text>@await Html.PartialAsync("_StatusBadge", new Args(g)) @g.funder.Or("") · Deadline: @await Html.PartialAsync("_Deadline", new Args(g)) · </text>}<span class="badge green">match score @Score(n.score)</span></div>
          <div class="small muted">@Strf(n.created_at, "%d %b %Y %H:%M") UTC</div>
        </div>
      </div>
      }
    }
    else {<p class="muted">No notifications yet. They are created automatically when a new grant matches your research.</p>}
  </div>
</div>