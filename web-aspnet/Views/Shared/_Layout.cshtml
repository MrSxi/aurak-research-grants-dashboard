<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] as string ?? "AURAK Research Grants Dashboard")</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@@300;400;500;600;700&family=Fira+Sans+Extra+Condensed:wght@@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
  <link rel="stylesheet" href="/static/aurak.css">
</head>
<body>
  @* Thin red top bar with gold quick-action buttons (aurak.ac.ae header) *@
  <div class="topbar">
    <div class="container">
      @if (M.user && M.limited)
      {
        <a class="qa" href="/me"><i class="far fa-user"></i><span class="lbl">My Profile</span></a>
        <a class="icon-btn" href="/logout" title="Log out (@M.user.name)"><i class="fas fa-sign-out-alt"></i></a>
      }
      else if (M.user)
      {
        <a class="qa" href="/grants"><i class="fas fa-file-signature"></i><span class="lbl">Grants</span></a>
        @if (M.user.role != "admin")
        {
        <a class="qa" href="/notifications"><i class="far fa-bell"></i><span class="lbl">Notifications</span>@if (M.notif_count) {<span class="count">@M.notif_count</span>}</a>
        }
        else
        {
        <a class="qa" href="/admin/queue"><i class="fas fa-clipboard-check"></i><span class="lbl">Approvals</span>@if (M.notif_count) {<span class="count">@M.notif_count</span>}</a>
        }
        <a class="qa" href="/chat"><i class="far fa-comments"></i><span class="lbl">Chat</span></a>
        <a class="qa" href="@(M.user.role == "admin" ? "/admin" : "/me")"><i class="far fa-user"></i><span class="lbl">@(M.user.role == "admin" ? "Admin" : "My Profile")</span></a>
        <a class="icon-btn" href="/grants#search" title="Search grants"><i class="fas fa-search"></i></a>
        <a class="icon-btn" href="/logout" title="Log out (@M.user.name)"><i class="fas fa-sign-out-alt"></i></a>
      }
      else
      {
        <a class="qa" href="/login"><i class="fas fa-sign-in-alt"></i><span class="lbl">Log in</span></a>
        <a class="qa" href="/signup"><i class="fas fa-user-plus"></i><span class="lbl">Student sign up</span></a>
      }
    </div>
  </div>

  @* White navigation bar: AURAK logo left, menu right *@
  <nav class="navbar">
    <div class="container">
      <a class="brand" href="/">
        <img src="https://aurak.ac.ae/storage/assets/images/american-university-uae.webp" alt="AURAK — American University of Ras Al Khaimah"
             onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <span class="wordmark">AURAK<small>AMERICAN UNIVERSITY OF RAS AL KHAIMAH</small></span>
        <span class="product">Research Grants<span>Dashboard</span></span>
      </a>
      <button class="menu-toggle" aria-label="Menu" onclick="document.getElementById('menu').classList.toggle('open')"><i class="fas fa-bars"></i></button>
      <ul class="menu" id="menu">
        @foreach (var item in M.nav)
        {
          <li><a href="@item[0]" class="@(M.active == item[0] ? "active" : "")">@item[1]</a></li>
        }
      </ul>
    </div>
  </nav>

  @* Red tagline strip *@
  <div class="tagline">AURAK Research Grants Dashboard: find funding, find collaborators.</div>

  @RenderSection("hero", required: false)

  <main>
    @if (M.flash)
    {
      <div class="container"><div class="flash @M.flash.kind">@M.flash.text</div></div>
    }
    @RenderBody()
  </main>

  @if (M.user && !M.limited && M.active != "/chat")
  {
    <a class="fab" href="@("/chat" + (Page.Has("grant") && Page["grant"].Truthy ? "?grant_id=" + Page["grant"]["id"] : ""))" title="Ask the research assistant"><i class="fas fa-comment-dots"></i></a>
  }

  <footer class="footer">
    <div class="container">
      <div><strong>AURAK Research Grants Dashboard</strong><br>Prototype for the American University of Ras Al Khaimah. Grant data comes from each funder's public source; always confirm details on the funder's page before applying.</div>
      <div class="small">Match scores rank research similarity; they are not probabilities and do not mean a person is available or willing to collaborate.<br>Data refresh every @Int(M.refresh_hours) hours.</div>
    </div>
  </footer>
  @RenderSection("scripts", required: false)
</body>
</html>
