@inherits AurakView<Args>
@{ var b = (string)Model.A; var qs = (string?)Model.B ?? ""; var label = (string?)Model.C ?? "Export"; var tail = qs != "" ? "?" + qs : ""; }
<div class="export-bar"><span class="export-label"><i class="fas fa-file-export"></i> @label</span><a class="btn sm ghost" href="@(b).pdf@(tail)" download><i class="fas fa-file-pdf"></i> PDF</a><a class="btn sm ghost" href="@(b).xlsx@(tail)" download><i class="fas fa-file-excel"></i> Excel</a><a class="btn sm ghost" href="@(b).csv@(tail)" download><i class="fas fa-file-csv"></i> CSV</a></div>