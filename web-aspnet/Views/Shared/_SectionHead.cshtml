@inherits AurakView<Args>
@{ var title = (string)Model.A; var link = (string?)Model.B; var linkText = (string?)Model.C ?? "View All"; }
<div class="section-head"><h2>@title</h2><div class="rule"></div>@if (link != null) {<a class="view-all" href="@link">@linkText <i class="fas fa-chevron-right small"></i></a>}</div>
