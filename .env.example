# Copy to .env and adjust. Local prototype only: never commit .env.

# Optional free OpenAlex key (larger daily budget). Leave empty to use the shared pool.
OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@aurak.ac.ae

# Database (SQLite by default; Microsoft SQL Server or PostgreSQL is only this line)
# Copy the current data into SQL Server first with: .venv-local\Scripts\python scripts\migrate_to_mssql.py "<url>"
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/aurak?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# DATABASE_URL=postgresql+psycopg://user:pass@host/aurak
SECRET_KEY=change-me-for-any-shared-machine

# Demo accounts seeded by scripts/import_data.py
ADMIN_EMAIL=admin@demo.aurak.local
ADMIN_PASSWORD=admin123
FACULTY_EMAIL=faculty@demo.aurak.local
FACULTY_PASSWORD=faculty123
# The demo faculty account is linked to this real faculty record (name match)
FACULTY_DEMO_NAME=Khaled Abdalgader
STUDENT_EMAIL=student@demo.aurak.local
STUDENT_PASSWORD=student123
# Approved student example (Research Assistant). Log in with the student ID or the email.
DEMO_RA_NAME=Demo Research Assistant
DEMO_RA_STUDENT_ID=2023000001
DEMO_RA_EMAIL=ra@demo.aurak.local
DEMO_RA_PASSWORD=ra123
# Example student ID shown on the sign-up form
STUDENT_ID_EXAMPLE=2023000000

# Refresh schedule (hours) for grant sources + OpenAlex publications
REFRESH_HOURS=6
SCHEDULER_ENABLED=1
GRANTS_GOV_MAX=600
EU_MAX=1500

# Matching (weights are normalised over the components a person has)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCH_WEIGHT_INTERESTS=0.35
MATCH_WEIGHT_PUBLICATIONS=0.30
MATCH_WEIGHT_TOPICS=0.15
MATCH_WEIGHT_PAST_GRANTS=0.10
MATCH_WEIGHT_KEYWORDS=0.10
MATCH_MIN=0.33
MATCH_STRONG=0.45
NOTIFY_MIN_SCORE=0.40
NOTIFY_TOP_N=5

# Chatbot (RAG + local open-source LLM)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# CPU-only laptops are slow: wait up to this many seconds between streamed chunks
LLM_TIMEOUT=900
# Keep the model loaded between questions (the app also preloads it at startup)
LLM_KEEP_ALIVE=60m

# Optional: answer with Claude or Microsoft instead of the local model. Same RAG, same database records.
# Pick ONE provider and fill in its key. Leave LLM_PROVIDER=ollama to keep the local Qwen model.
#   LLM_PROVIDER=claude        -> Claude through the Anthropic API (console.anthropic.com)
#   LLM_PROVIDER=claude_azure  -> Claude through Microsoft Foundry (Azure)
#   LLM_PROVIDER=azure_openai  -> Microsoft Azure OpenAI (the models behind MS Copilot)
ANTHROPIC_API_KEY=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
CLAUDE_MODEL=claude-opus-5-5
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# If the cloud provider has no key or cannot be reached, answer with the local model instead (1 = yes)
LLM_FALLBACK_TO_OLLAMA=1
